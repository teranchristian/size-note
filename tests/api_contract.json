          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "match_type": {
          "enum": [
            "name",
            "alias",
            "similar"
          ],
          "type": "string"
        },
        "matched_value": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "score": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "growth_stage",
        "matched_value",
        "match_type",
        "score"
      ],
      "type": "object"
    },
