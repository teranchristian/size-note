            "type": "string"
          },
          "type": "array"
        },
        "growth_stage": {
          "default": "adult",
          "enum": [
            "adult",
            "child"
          ],
          "type": "string"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "PersonRead": {
      "properties": {
        "aliases": {
